<!DOCTYPE html>

<html lang="ko">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>홍주 — 토마토밭의 유언</title>

<link rel="preconnect" href="https://fonts.googleapis.com">

<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link href="https://fonts.googleapis.com/css2?family=Gowun+Batang:wght@400;700&family=Song+Myung&display=swap" rel="stylesheet">

<style>

  :root{

    --bg: #14100d;

    --bg-deep: #0d0a08;

    --panel: #1c1611;

    --ink: #e7dcc7;

    --ink-dim: #9c8f78;

    --ink-faint: #6b6153;

    --gold: #a9793f;

    --blood: #b23a2e;

    --blood-bright: #cf4a3a;

    --steel: #5c6673;

    --rule: rgba(231, 220, 199, 0.10);

    --dialogue: #e3b46e;

    --dialogue-soft: rgba(227, 180, 110, 0.5);

  }



  *{ box-sizing: border-box; }



  html{ scroll-behavior: smooth; }



  body{

    margin:0;

    background:

      radial-gradient(ellipse 900px 500px at 50% -10%, rgba(169,121,63,0.07), transparent 60%),

      radial-gradient(ellipse 700px 600px at 90% 100%, rgba(178,58,46,0.05), transparent 55%),

      var(--bg-deep);

    color: var(--ink);

    font-family: 'Gowun Batang', serif;

    -webkit-font-smoothing: antialiased;

  }



  /* 상단 진행 표시줄 — 아비의 온기(금)에서 시작해 폭력의 핏빛을 지나 법정의 냉기(강철)로 */

  #progress{

    position: fixed; top:0; left:0; height:3px; width:0%;

    background: linear-gradient(90deg, var(--gold), var(--blood-bright), var(--steel));

    z-index: 50;

    transition: width 0.08s linear;

  }



  .wrap{

    max-width: 660px;

    margin: 0 auto;

    padding: 0 28px 140px;

  }



  /* 표지 헤더 */

  header.hero{

    padding: 128px 0 60px;

    text-align: center;

    position: relative;

  }



  .glyph{

    width: 34px; height: 34px;

    margin: 0 auto 34px;

    opacity: 0.85;

  }



  h1.title{

    font-family: 'Song Myung', serif;

    font-size: clamp(48px, 11vw, 76px);

    font-weight: 400;

    letter-spacing: 0.06em;

    margin: 0;

    color: var(--ink);

    line-height: 1;

  }



  .subtitle{

    font-size: 13px;

    color: var(--ink-dim);

    letter-spacing: 0.32em;

    margin: 18px 0 0;

  }



  .hero-rule{

    width: 1px; height: 56px;

    background: linear-gradient(to bottom, transparent, var(--ink-faint));

    margin: 40px auto 0;

  }



  /* 본문 */

  article{

    font-size: 18.5px;

    line-height: 2.05;

    letter-spacing: 0.01em;

    color: var(--ink);

  }



  article p{

    margin: 0 0 1.55em;

    text-align: justify;

    word-break: keep-all;

  }



  article p.dialogue{

    margin: 0.9em 0 0.9em 22px;

    padding-left: 18px;

    border-left: 2px solid var(--dialogue-soft);

    color: var(--dialogue);

    font-size: 0.97em;

    letter-spacing: 0.015em;

  }



  /* 첫 문단 드롭캡 */

  article > p:first-of-type::first-letter{

    font-family: 'Song Myung', serif;

    font-size: 3.6em;

    float: left;

    line-height: 0.85;

    padding: 0.06em 0.1em 0 0;

    color: var(--blood-bright);

  }



  /* 장면 전환 장식 — 토마토 씨앗을 닮은 세 개의 점 */

  .divider{

    display:flex;

    align-items:center;

    justify-content:center;

    gap: 10px;

    margin: 3em 0;

  }

  .divider span{

    width: 5px; height: 5px;

    border-radius: 50%;

    background: var(--blood);

    opacity: 0.75;

  }

  .divider span:nth-child(2){

    width: 7px; height: 7px;

    background: var(--gold);

  }



  /* 큰 전환점 — 인용구 스타일 */

  .turn{

    margin: 3.2em 0;

    padding: 28px 26px;

    background: linear-gradient(180deg, rgba(178,58,46,0.06), transparent);

    border-left: 2px solid var(--blood);

    border-radius: 2px;

  }

  .turn p{

    margin: 0;

    font-style: normal;

    font-size: 19px;

    color: #f0e6d4;

    text-align: left;

  }

  .turn .tag{

    display:block;

    font-family: 'Song Myung', serif;

    font-size: 11px;

    letter-spacing: 0.3em;

    color: var(--blood-bright);

    text-transform: uppercase;

    margin-bottom: 12px;

  }



  /* 좌측 서사 축 — 위에서 아래로 금 → 핏빛 → 강철 */

  .rail{

    position: fixed;

    left: calc(50% - 400px);

    top: 0;

    bottom: 0;

    width: 1px;

    background: linear-gradient(

      to bottom,

      var(--gold) 0%,

      var(--gold) 15%,

      var(--blood) 42%,

      var(--blood) 60%,

      var(--steel) 85%,

      var(--steel) 100%

    );

    opacity: 0.35;

  }

  @media (max-width: 1100px){

    .rail{ display:none; }

  }



  footer.end{

    text-align: center;

    margin-top: 90px;

    padding-top: 48px;

    border-top: 1px solid var(--rule);

  }

  footer.end .mark{

    font-family: 'Song Myung', serif;

    font-size: 13px;

    letter-spacing: 0.35em;

    color: var(--ink-faint);

    text-transform: uppercase;

  }



  ::selection{

    background: var(--blood);

    color: #fff;

  }



  @media (max-width: 480px){

    .wrap{ padding: 0 20px 100px; }

    header.hero{ padding: 72px 0 48px; }

    article{ font-size: 17px; line-height: 1.95; }

    article p.dialogue{ margin-left: 8px; padding-left: 14px; }

    .turn{ padding: 22px 18px; }

  }



  @media (prefers-reduced-motion: reduce){

    html{ scroll-behavior: auto; }

    #progress{ transition: none; }

  }

</style>

</head>

